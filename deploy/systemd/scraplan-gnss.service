[Unit]
Description=Atheer RADAR GNSS-anomaly episode detector (behavioural G4a — spoofing/jamming episodes)

[Service]
Type=oneshot
WorkingDirectory=/home/gis-syr/Desktop/scraplan
# DATABASE_URL lives in the git-ignored project .env (loaded via python-dotenv;
# EnvironmentFile '-' also injects it). User-unit pattern: no network-online.target
# (a SYSTEM target absent from the user session) — matches scraplan-rendezvous/zone-dwell.
EnvironmentFile=-/home/gis-syr/Desktop/scraplan/.env
# Wait briefly for the DB (same nc probe as its siblings), then never block boot.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do nc -z 127.0.0.1 5435 && exit 0; sleep 2; done; exit 0'
# Idempotent recompute-and-replace (A2 discipline, the same as rendezvous): rebuilds the
# broadcast jamming zone in-process, re-derives every per-vessel episode from current
# history and REPLACES the gnss_anomaly rows in maritime_events. Measured cost 2.50 s wall /
# 3.02 s CPU / 308 MB RSS — cheaper than the ~2 s rendezvous run it mirrors.
ExecStart=/home/gis-syr/Desktop/scraplan/.venv/bin/python scripts/detect_gnss_anomaly.py
