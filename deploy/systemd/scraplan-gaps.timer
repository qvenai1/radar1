[Unit]
Description=Re-run AIS-gap detection every 15 minutes (surfaces candidates as gaps close)

[Timer]
# Every 15 minutes — a gap becomes a candidate the first run after the vessel
# reappears (closes the gap). The detector is idempotent, so frequent runs only
# refresh; they never duplicate.
OnCalendar=*:0/15
# Power-loss resilient: a run missed while the box was off fires on next boot.
Persistent=true

[Install]
WantedBy=timers.target
