# mtscraper runtime configuration — read by the systemd user service.
#
# Installed copy lives at ~/.config/mtscraper/mtscraper.env and is NEVER
# overwritten by a re-run of install.sh, so your edits survive upgrades.
# After editing:  systemctl --user restart mtscraper
#
# NOTE: syntax is systemd EnvironmentFile, not shell — no `export`, no command
# substitution, no variable references. Plain KEY=value only.

# ---------------------------------------------------------------- output path
# THE ONE LINE TO CHANGE when moving the archive to another disk.
# Currently the internal NVMe, which was 94% full when this was set up.
# To switch to an external drive, mount it and set BOTH lines, e.g.:
#   MT_OUTPUT_DIR=/media/gis-syr/EXTERNAL/mt_output
#   MT_REQUIRE_MOUNT=/media/gis-syr/EXTERNAL
# The service refuses to start if this path is not writable (see preflight.sh),
# so a service that is down after unplugging the drive is by design, not a bug.
MT_OUTPUT_DIR=/home/gis-syr/Desktop/mtscraper/mt_output

# Mountpoint that MUST be a live filesystem before collection starts. Leave empty
# for a path on the internal disk. Set it whenever MT_OUTPUT_DIR lives on a
# removable drive: an unmounted drive leaves its mountpoint behind as an empty
# directory, so without this assertion the archive would quietly write to the
# internal disk and fill the very filesystem the move was meant to spare.
MT_REQUIRE_MOUNT=

# ------------------------------------------------------------- disk guard
# Preflight refuses to start when the filesystem holding MT_OUTPUT_DIR has less
# than this much free. Sized against the rate measured on this host: 466 B/record
# x ~1309 in-area vessels/cycle = ~596 KB per cycle, at a real ~215s period =
# ~245 MB/day. So 5 GB is roughly 20 days of runway — enough to notice and act
# before the disk fills.
MT_MIN_FREE_GB=5

# ------------------------------------------------------------ collection pace
# Seconds to sleep BETWEEN cycles — a delay after each cycle's work, not a fixed
# period. Measured: ~95s of work + 120s sleep = a real ~215s cadence. Budget with
# that in mind rather than assuming 120s.
MT_POLL_INTERVAL_S=120

# Passive mode reloads the page only after this many consecutive empty cycles.
MT_PASSIVE_RELOAD_AFTER_EMPTY=5

# ------------------------------------------------------- time-series volume
# How often an unchanged vessel is re-written anyway, as positive evidence it is
# still present and reporting. Between heartbeats, a vessel is written only when
# something actually changes.
#
# Why this exists: the upstream feed refreshes a moving vessel every ~9.3 min
# (median, measured over 28k real updates) while collection polls every ~2.3 min,
# so ~83% of a naive archive is the same fix restated. Replaying 400k real records
# through the change-detecting sink: 195 MB -> 33 MB, a 5.8x reduction with no
# position lost. Set to 0 to store every observation as before.
MT_POSITION_HEARTBEAT_S=3600

# ------------------------------------------------------------- enrichment
# Identities resolved per cycle. Resolution is ONE-TIME per vessel (results are
# cached and never re-fetched), so this drains a finite queue rather than feeding
# a stream — there is no reason to race.
#
# 25/cycle was a mistake: at ~626 cycles/day that is ~15,650 detail requests a day
# from one address, sized to clear the backlog in 8 hours. What followed was four
# days of steady decline (605 -> 244 -> 101 -> 67 -> 17 resolved per day) ending in
# a total block. 3/cycle is ~1,880/day and clears ~5,200 pending in under 3 days,
# which costs nothing real.
#
# Not 1: a cycle that resolves zero is treated as fully blocked and escalates the
# exponential cool-down (orchestrator.py), so a single transient miss would trip
# it. 3 leaves room to absorb one.
MT_ENRICH_PER_CYCLE=3

# Seconds between per-vessel detail calls. Raised from 1.5 to spread the burst:
# the shape of the traffic matters as much as its volume — 25 calls packed into
# 37s then silence reads very differently from a few spaced a minute apart.
MT_ENRICH_THROTTLE_S=5

# ------------------------------------------------------------- validation
# Deliberately left unset — the code's defaults apply, so the flags on new records
# stay comparable with everything collected before this service existed. Changing
# a threshold here changes what the archive *means*, not just how it runs, so set
# one only on purpose. Defaults: MAX_SPEED_KN=60, STALE_AFTER_MIN=180,
# GAP_THRESHOLD_S=1800.
#
# (Measured: tightening STALE_AFTER_MIN to 60 flagged 297 of 1309 records
# stale_position in a single cycle. Vessels out of AIS range legitimately go hours
# between reports, so the 180 default is the honest threshold.)

# Operational only — how long to wait for the map to load; no effect on data.
MT_NAV_TIMEOUT_S=60

# --------------------------------------------------------------- proxies
# Untested in this deployment — rotation is built and unit-tested, but its
# anti-ban efficacy depends on genuine RESIDENTIAL proxies (datacenter ones are
# fingerprinted by Cloudflare immediately). Left empty: a single session, which
# ran without a block during setup. To enable, write one proxy per line to a file
# and add `--proxies <file> --profile-count 4` to ExecStart in the unit.
# MT_PROXY=
