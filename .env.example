# Copy to .env and fill in real values. NEVER commit .env.
# docker-compose reads POSTGRES_PASSWORD; all Python processes read DATABASE_URL.

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://opensky:change-me@127.0.0.1:5435/opensky

# Collector DB mirror (Phase 2). The collector only writes to the DB when
# --db-url is passed or OPENSKY_DB_URL is set — deliberately separate from
# DATABASE_URL so simply having a .env never changes collector behavior.
#OPENSKY_DB_URL=postgresql://opensky:change-me@127.0.0.1:5435/opensky

# OpenSky OAuth2 credentials are NOT configured here — the collector reads
# OPENSKY_CLIENT_ID / OPENSKY_CLIENT_SECRET from the environment, and the
# canonical copy lives in ~/.config/opensky/credentials.json.

# ==============================================================================
# Maritime AIS layer (tracker_maritime.py + maritime/) — all optional per source
# ==============================================================================

# 1) AISStream.io — the primary live source (REQUIRED to run tracker_maritime).
#    Free API key: https://aisstream.io/  (register → dashboard → API key).
#    NOTE: AISStream is TERRESTRIAL AIS only — reliable coverage ~40-60 NM off
#    shore; the open ocean is dark. Absence of a vessel is NOT evidence of
#    absence, and AIS is self-reported/spoofable — verify against a 2nd source.
AISSTREAM_API_KEY=

# 2) Global Fishing Watch — historical tracks + AIS-gap (dark-activity) lookup.
#    Free with registration: https://globalfishingwatch.org/our-apis/
#    Adapter is disabled (lookup no-op) unless this is set.
#GFW_API_TOKEN=

# 3) Equasis — vessel identity (owner/manager/flag) by IMO. No official API;
#    the adapter is an isolated, ToS-respecting, rate-limited scraper that is
#    DISABLED unless ALL THREE below are set (email + password + explicit opt-in).
#    Respect https://www.equasis.org terms; keep the 6 s request floor.
#EQUASIS_EMAIL=
#EQUASIS_PASSWORD=
#EQUASIS_ENABLE=1

# 4) Copernicus Data Space — Sentinel-1 SAR / Sentinel-2 imagery availability,
#    to visually confirm a vessel that switched AIS off (phase 2 stub).
#    Catalogue discovery is anonymous; product download needs these.
#    Register: https://dataspace.copernicus.eu/
#COPERNICUS_CLIENT_ID=
#COPERNICUS_CLIENT_SECRET=

# ==============================================================================
# Satellite layer
# ==============================================================================
# CelesTrak (tracker_satellites.py + S1 SATCAT enrichment) is KEYLESS — no
# config needed here.
#
# Space-Track.org (S2a — backend/spacetrack_client.py): authenticated second
# source, for later decay/reentry (TIP) ingest. Credentials are read from the
# environment ONLY (never hardcoded, never committed, never logged). Register a
# free account at https://www.space-track.org and set:
#SPACETRACK_USER=
#SPACETRACK_PASS=
# Optional tuning (defaults shown). Space-Track's hard limit is <30 req/min and
# <300 req/hour; these defaults sit safely below it — do NOT raise past the cap.
#SPACETRACK_BASE_URL=https://www.space-track.org
#SPACETRACK_MAX_PER_MIN=20
#SPACETRACK_MAX_PER_HOUR=200
#SPACETRACK_TIMEOUT_S=30

# ==============================================================================
# Update bot — NOTIFY-1/2 (backend/notify/, migrations 039 + 040)
# ==============================================================================
# A PUBLIC SUBSCRIPTION bot. Any Telegram user sends /start to subscribe and
# receives alerts in their own private chat; /stop pauses, /delete erases.
# Filters: /countries and /families.
#
# TWO UNITS, and they must both run:
#   scraplan-notify.timer            the TICK — decides what is an event and
#                                    enqueues it per subscriber. No Telegram.
#   scraplan-notify-gateway.service  the GATEWAY — the ONLY process that talks
#                                    to Telegram: long-polls commands, drains
#                                    the outbox. Resident.
# They are split because Telegram's rate limits are per-BOT: two senders would
# each respect a client-side floor and together break the real ceiling.
#
# DISABLED unless the token is set. The token is never logged.
#
# Setup:
#   1. Talk to @BotFather -> /newbot -> copy the token here.
#   2. BotFather -> /setprivacy -> Disable is NOT needed (the bot only reads
#      commands addressed to it). Leave privacy ON.
#   3. systemctl --user enable --now scraplan-notify.timer
#      systemctl --user enable --now scraplan-notify-gateway.service
#   4. Send /start to your bot. No chat id to look up — that is what /start is.
#
# ⚠ The FIRST tick baselines the whole standing picture and enqueues nothing;
#   and each new subscriber gets a COUNTS summary on /start, never the ~225
#   standing alerts (~200 of them maritime leads days old).
#TELEGRAM_BOT_TOKEN=
#
# OPTIONAL operator chat. This is NO LONGER the audience — /start is. It is
# seeded as a subscriber on first gateway start, which is the upgrade path from
# the old single-recipient bot so an existing install keeps receiving.
#TELEGRAM_CHAT_ID=
#
# Optional tuning (defaults shown).
#   NOTIFY_API_URL      the feed the bot reads — the same endpoint the dashboard uses
#   NOTIFY_WINDOW_HOURS feed window; match the dashboard so both answer one question
#   NOTIFY_MIN_INTERVAL_S  client-side floor between sends. Telegram's 429 (with its
#                       retry_after) is the real limiter and is always obeyed; this
#                       just keeps normal operation away from the limit.
#NOTIFY_API_URL=http://127.0.0.1:8000/api/v1/alerts
#NOTIFY_WINDOW_HOURS=24
#NOTIFY_MIN_INTERVAL_S=0.05

# ---------------------------------------------------------------------------
# DASHBOARD_WRITE_TOKEN — guards the ONLY mutating endpoint (POST /alerts/triage).
#
# ⛔ FAIL CLOSED: leave it unset and every write is REFUSED (503). The opposite default
# would silently disarm the guard on exactly the deployment that forgot to set it.
#
# ⛔ IT IS NOT AUTHENTICATION. The dashboard is a static bundle delivered to a browser, so it
# cannot hold a secret from whoever opens it. What this stops is everything that reaches the
# port WITHOUT opening the dashboard — a scanner, a stray service, another LAN device. That
# matters here because `server.py` is deliberately run with `--host 0.0.0.0` so several
# analysts on different machines share one screen.
#
# ⚠ A SHARED passphrase for the team, matching the decision that there is no per-analyst
# identity. It identifies nobody; the record of who did what stays in `alert_triage.note`.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# ATHEER_API_KEY — opt-in READ gate over /api/* and the WS stream.
#
# ⚠ Unset = OPEN READS (today's documented contract for the LAN dashboard). This is the
# deliberate opposite of the write token's fail-closed rule: refusing every read on the
# deployment that never set a key would turn each restart into a dashboard outage.
#
# When set: every /api/* request must carry `x-atheer-key: <key>` (or `?api_key=`), and
# the WS handshake must carry `?api_key=` — the SPA sends both automatically once the
# analyst stores the key (localStorage "atheer-api-key", same contract as the write
# token). Same caveat as above: it is a shared passphrase, not per-analyst identity.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ATHEER_API_KEY=

# ---------------------------------------------------------------------------
# Operator tunables (arch review finding 8) — every knob that used to be a
# compiled-in module constant. Defaults are the long-measured values; override
# here + restart instead of editing code. Units in the name (S=seconds).
#MARITIME_STALE_S=180     # AIS snapshot considered stale (cadence 30 s)
#MILITARY_STALE_S=120
#ADSB_STALE_S=120         # adsb_scraper cycle ~15 s; allows several misses
#MT_DB_LOOKBACK_DAYS=60   # /maritime marinetraffic DB-fallback window
#MT_LATEST_LIMIT=3000     # row cap of that fallback query
#DARK_TTL_S=1800          # GFW dark-vessels response cache
#ZONE_MASK_TTL_S=600      # zone busy/port masks cache
#HOST_CACHE_S=600         # journalctl boot-table cache
#HOST_GAP_MIN_S=900       # minimum host-off window that counts as a gap
